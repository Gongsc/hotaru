{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chart",
  "description": "Chart popover: needs window mutations (setSize/hide) and monitor queries that core:default does not grant.",
  "windows": ["chart"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "core:window:allow-current-monitor",
    "core:window:allow-start-dragging"
  ]
}
